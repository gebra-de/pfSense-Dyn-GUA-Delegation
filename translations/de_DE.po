#: files/usr/local/pkg/dgpd.inc:1392
msgid "Accept a fully validated, upstream-contained and collision-free native Kea PD change as the new DGPD assignment."
msgstr "Eine vollständig geprüfte, im Upstream enthaltene und konfliktfreie native Kea-PD-Änderung als neue DGPD-Zuweisung übernehmen."

