msgid "Conflict Resolution"
msgstr "Konfliktbehebung"

#: files/usr/local/pkg/dgpd.inc:838
msgid "Conflict-free native PD change accepted; DGPD ownership updated."
msgstr ""
"Konfliktfreie native PD-Änderung übernommen; DGPD-Zuständigkeit aktualisiert."

