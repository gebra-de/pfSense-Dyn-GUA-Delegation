msgid "Active assignments"
msgstr "Aktive Zuweisungen"

#: files/usr/local/pkg/dgpd.inc:1422
msgid "Adopt a validated, upstream-contained, collision-free native assignment."
msgstr "Eine geprüfte, im Upstream enthaltene und konfliktfreie native Zuweisung übernehmen."

#: files/usr/local/pkg/dgpd.inc:421
msgid "Allocator upstream missing"
msgstr "Upstream des Allocators fehlt"

#: files/usr/local/pkg/dgpd.inc:1379
msgid "Allocator upstream prefix and pool length."
msgstr "Upstream-Präfix und Pool-Länge des Allocators."

#: files/usr/local/pkg/dgpd.inc:603
msgid "Already unmanaged"
msgstr "Bereits nicht verwaltet"

#: files/usr/local/pkg/dgpd.inc:645
msgid "An active IA_PD lease exists in this DGPD assignment; explicit revocation confirmation is required"
msgstr "Für diese DGPD-Zuweisung besteht eine aktive IA_PD-Lease; der Widerruf muss ausdrücklich bestätigt werden"

#: files/usr/local/pkg/dgpd.inc:1363 files/usr/local/pkg/dgpd.inc:1414
msgid "Apply Assignment"
msgstr "Zuweisung anwenden"

#: files/usr/local/pkg/dgpd.inc:1354
msgid "Available Prefixes"
msgstr "Verfügbare Präfixe"

#: files/usr/local/pkg/dgpd.inc:1042
msgid "Cannot lock DGPD worker signal"
msgstr "DGPD-Worker-Signal kann nicht gesperrt werden"

#: files/usr/local/pkg/dgpd.inc:1038
msgid "Cannot open DGPD worker signal; pending state retained"
msgstr "DGPD-Worker-Signal kann nicht geöffnet werden; ausstehender Zustand bleibt erhalten"

#: files/usr/local/pkg/dgpd.inc:1051
msgid "Cannot save DGPD worker signal"
msgstr "DGPD-Worker-Signal kann nicht gespeichert werden"

#: files/usr/local/pkg/dgpd.inc:1386
msgid "Save the staged assignment, verify the live Kea pool, and finalize DGPD status."
msgstr "Die vorbereitete Zuweisung speichern, den aktiven Kea-Pool prüfen und den DGPD-Status abschließen."

#: files/usr/local/pkg/dgpd.inc:1415
msgid "Save the staged operation and verify the live Kea pool."
msgstr "Die vorbereitete Operation speichern und den aktiven Kea-Pool prüfen."

#: files/usr/local/pkg/dgpd.inc:697
msgid "Allow Interface Management for the selected interface (checkbox)"
msgstr "Aktivieren Sie für die ausgewählte Schnittstelle das Kontrollkästchen „Schnittstellenverwaltung erlauben“"

#: files/usr/local/pkg/dgpd.inc:1237
msgid "Confirm that downstream routers may require DHCPv6-PD renewal or manual reconfiguration"
msgstr "Bestätigen Sie, dass Downstream-Router möglicherweise eine DHCPv6-PD-Erneuerung oder manuelle Neukonfiguration benötigen"

#: files/usr/local/pkg/dgpd.inc:1420
msgid "Confirm that the persistent downstream impact notice was reviewed."
msgstr "Bestätigen, dass der dauerhafte Hinweis zu Downstream-Auswirkungen geprüft wurde."

#: files/usr/local/pkg/dgpd.inc:586
msgid "Conflict-free native PD change accepted; DGPD ownership updated."
msgstr "Konfliktfreie native PD-Änderung übernommen; DGPD-Zuständigkeit aktualisiert."

#: files/usr/local/pkg/dgpd.inc:1413
msgid "Copy a free, unreserved candidate into the editor without saving it."
msgstr "Einen freien, nicht reservierten Kandidaten in den Editor kopieren, ohne ihn zu speichern."

#: files/usr/local/pkg/dgpd.inc:1384
msgid "Copy the displayed allocator proposal into Delegated PD and Delegated Length, replacing your edits. This does not save, reserve a prefix, or change services. Apply checks availability again."
msgstr "Den angezeigten Allocator-Vorschlag in Delegiertes PD und Delegierte Länge kopieren und vorhandene Eingaben ersetzen. Dadurch wird nichts gespeichert, kein Präfix reserviert und kein Dienst geändert. Beim Anwenden wird die Verfügbarkeit erneut geprüft."

