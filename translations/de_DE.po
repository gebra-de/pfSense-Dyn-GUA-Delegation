msgid "Prefix sources disagree: allocator / Router Advertisements; changes blocked"
msgstr "Präfixquellen widersprechen sich: Allocator / Router Advertisements; Änderungen blockiert"

#: files/usr/local/pkg/dgpd.inc:1511
msgid "Proposal (not reserved)"
msgstr "Vorschlag (nicht reserviert)"

#: files/usr/local/pkg/dgpd.inc:1362 files/usr/local/pkg/dgpd.inc:1413
msgid "Propose"
msgstr "Vorschlagen"

#: files/usr/local/pkg/dgpd.inc:1313
#, python-format, php-format
msgid "RA fallback: %s/%d advertised; upstream unconfirmed, changes blocked."
msgstr "RA-Fallback: %s/%d angekündigt; Upstream unbestätigt, Änderungen blockiert."

#: files/usr/local/pkg/dgpd.inc:1368 files/usr/local/pkg/dgpd.inc:1419
msgid "Recover"
msgstr "Wiederherstellen"

#: files/usr/local/pkg/dgpd.inc:1390
msgid "Recover a saved operation after resolving a failure. This does not reset assignments or remove leases."
msgstr "Eine gespeicherte Operation nach Behebung eines Fehlers wiederherstellen. Zuweisungen werden nicht zurückgesetzt und Leases nicht entfernt."

#: files/usr/local/pkg/dgpd.inc:1371 files/usr/local/pkg/dgpd.inc:1423
msgid "Release Ownership"
msgstr "Zuständigkeit freigeben"

#: files/usr/local/pkg/dgpd.inc:1393
msgid "Release the DGPD reservation while leaving the current native DHCPv6 configuration unchanged."
msgstr "Die DGPD-Reservierung freigeben und die aktuelle native DHCPv6-Konfiguration unverändert lassen."

#: files/usr/local/pkg/dgpd.inc:1389
msgid "Remove the native PD pool and release the DGPD reservation. Warning: Active IA_PD leases in this DGPD-owned pool will be revoked. This interrupts downstream prefix delegation and may require renewal or manual reconfiguration."
msgstr "Den nativen PD-Pool entfernen und die DGPD-Reservierung freigeben. Warnung: Aktive IA_PD-Leases in diesem von DGPD verwalteten Pool werden widerrufen. Dadurch wird die Downstream-Präfixdelegation unterbrochen und möglicherweise eine Erneuerung oder manuelle Neukonfiguration erforderlich."

#: files/usr/local/pkg/dgpd.inc:1418
msgid "Remove the native pool and release its DGPD reservation."
msgstr "Den nativen Pool entfernen und seine DGPD-Reservierung freigeben."

#: files/usr/local/pkg/dgpd.inc:1416
msgid "Remove the native pool and retain the DGPD reservation."
msgstr "Den nativen Pool entfernen und die DGPD-Reservierung beibehalten."

#: files/usr/local/pkg/dgpd.inc:1421
msgid "Replace an external native change with the saved DGPD assignment."
msgstr "Eine externe native Änderung durch die gespeicherte DGPD-Zuweisung ersetzen."

#: files/usr/local/pkg/dgpd.inc:701
